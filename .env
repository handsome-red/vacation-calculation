# Сервер
ADDR=:8080
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=30s
READ_HEADER_TIMEOUT=2s
SHUTDOWN_TIMEOUT=15s

# База данных
DB_PATH=./data/vacations.db
DB_MAX_CONN=10

# Пути
TEMPLATES_PATH=web/templates
STATIC_PATH=web/static

# Логирование
LOG_LEVEL=info
LOG_FORMAT=text

# Почта администратора: с неё сотрудникам приходит уведомление о начале отпуска
# за 28 календарных дней. Без SMTP_HOST, SMTP_USERNAME и SMTP_PASSWORD рассылка выключена.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465               # 465 — SSL, 587 — STARTTLS
# SMTP_USERNAME=
# SMTP_PASSWORD=              # у Яндекса и Mail.ru — пароль приложения
# SMTP_FROM=                  # по умолчанию SMTP_USERNAME
# SMTP_FROM_NAME=Калькулятор отпусков
# SMTP_TLS=                   # ssl | starttls; по умолчанию по порту
# HR_EMAIL=                   # отдел кадров, через запятую; по умолчанию — ящик администратора
# REMINDER_INTERVAL=1h        # как часто проверять, кому пора отправить

# Первый администратор — создаётся при старте, только если в БД нет ни одного.
# Если пользователь с ADMIN_EMAIL уже есть, ему выдаются права администратора.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_LAST_NAME=Администратор
# ADMIN_FIRST_NAME=Системный
# ADMIN_MIDDLE_NAME=
# ADMIN_BIRTH_DATE=1970-01-01
# ADMIN_POSITION=software_engineer
# ADMIN_HIRED_AT=           # по умолчанию — дата первого запуска
# ADMIN_DISTRICT=kazan
# ADMIN_DEPARTMENT=epidemiological_supervision